---
import Layout from '../layouts/Layout.astro';
import RegistrationForm from '../components/RegistrationForm.jsx';
---

<Layout 
  title="Startup Weekend Brussels 2026 - AI & Innovation Focus | Pre-Register Now"
  description="Join Startup Weekend Brussels 2026 with special focus on AI and emerging technologies. 54 hours to build the future. Pre-register now for early access!"
  canonical="https://startupweekend.brussels/2026-edition"
  ogType="event"
  breadcrumbs={[{name: "2026 Edition", url: "/2026-edition"}]}
>
  <!-- Event-specific Structured Data -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Event",
    "name": "Startup Weekend Brussels 2026: AI & Innovation",
    "description": "A 54-hour entrepreneurship event with special focus on AI and emerging technologies. Build startups with artificial intelligence at the core.",
    "startDate": "2026-04-01T18:00:00+02:00",
    "endDate": "2026-04-03T20:00:00+02:00",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "eventStatus": "https://schema.org/EventScheduled",
    "location": {
      "@type": "Place",
      "name": "Brussels, Belgium",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Brussels",
        "addressRegion": "Brussels-Capital Region",
        "addressCountry": "BE"
      }
    },
    "organizer": {
      "@type": "Organization",
      "name": "Startup Weekend Brussels",
      "url": "https://startupweekend.brussels",
      "sameAs": [
        "https://x.com/swbru",
        "https://www.facebook.com/swbru",
        "https://www.instagram.com/swbru/"
      ]
    },
    "offers": {
      "@type": "Offer",
      "name": "Pre-Registration",
      "availability": "https://schema.org/PreOrder",
      "url": "https://startupweekend.brussels/2026-edition#register",
      "validFrom": "2025-11-01"
    },
    "audience": {
      "@type": "Audience",
      "audienceType": "entrepreneurs, AI developers, designers, business professionals"
    },
    "keywords": ["AI", "artificial intelligence", "startup weekend", "brussels", "entrepreneurship", "innovation", "machine learning", "tech"],
    "performer": {
      "@type": "Organization",
      "name": "Startup Weekend Brussels"
    },
    "about": [
      {
        "@type": "Thing",
        "name": "Artificial Intelligence"
      },
      {
        "@type": "Thing", 
        "name": "Entrepreneurship"
      },
      {
        "@type": "Thing",
        "name": "Innovation"
      }
    ]
  }
  </script>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-600 via-purple-600 to-indigo-700 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="inline-block bg-white/20 backdrop-blur-sm rounded-lg px-4 py-2 mb-6">
          <span class="text-sm font-semibold">🎉 COMING SOON IN 2026</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold mb-6">
          Startup Weekend Brussels 2026
        </h1>
        <p class="text-xl md:text-2xl mb-4 text-blue-100">
          🤖 Special Focus: AI & Emerging Technologies
        </p>
        <p class="text-lg mb-8 text-blue-200 max-w-3xl mx-auto">
          Join entrepreneurs, AI experts, developers, and innovators for 54 hours of building the future with artificial intelligence.
        </p>
        <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6 max-w-2xl mx-auto">
          <div class="grid md:grid-cols-2 gap-4 text-center">
            <div>
              <div class="text-2xl font-bold">📅 When</div>
              <div class="text-blue-100">Spring 2026 (TBA)</div>
            </div>
            <div>
              <div class="text-2xl font-bold">📍 Where</div>
              <div class="text-blue-100">Brussels, Belgium</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AI Focus Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          🤖 Why AI & Technology Focus?
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Artificial Intelligence is transforming every industry. Join us to explore AI's potential and build the next generation of intelligent startups.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mb-12">
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-8">
          <div class="text-4xl mb-4">🧠</div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">AI Innovation</h3>
          <p class="text-gray-700">
            Build startups leveraging machine learning, natural language processing, computer vision, and other AI technologies.
          </p>
        </div>

        <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-xl p-8">
          <div class="text-4xl mb-4">🚀</div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Emerging Tech</h3>
          <p class="text-gray-700">
            Explore blockchain, IoT, AR/VR, quantum computing, and other cutting-edge technologies shaping our future.
          </p>
        </div>

        <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-xl p-8">
          <div class="text-4xl mb-4">🌍</div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Impact Solutions</h3>
          <p class="text-gray-700">
            Create AI-powered solutions for climate change, healthcare, education, and other global challenges.
          </p>
        </div>
      </div>

      <div class="bg-gradient-to-r from-blue-600 to-purple-600 rounded-2xl p-8 text-white text-center">
        <h3 class="text-2xl font-bold mb-4">Special AI Track Benefits</h3>
        <div class="grid md:grid-cols-3 gap-6">
          <div>
            <div class="text-3xl mb-2">🏅</div>
            <h4 class="font-semibold mb-1">AI Mentors</h4>
            <p class="text-blue-100 text-sm">Expert guidance from AI researchers and industry leaders</p>
          </div>
          <div>
            <div class="text-3xl mb-2">🛠️</div>
            <h4 class="font-semibold mb-1">AI Tools & APIs</h4>
            <p class="text-blue-100 text-sm">Access to cutting-edge AI platforms and development tools</p>
          </div>
          <div>
            <div class="text-3xl mb-2">💰</div>
            <h4 class="font-semibold mb-1">Special Prizes</h4>
            <p class="text-blue-100 text-sm">Dedicated awards for best AI innovation and social impact</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Event Timeline -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          54 Hours That Could Change Everything
        </h2>
        <p class="text-xl text-gray-600">
          Here's what to expect during your Startup Weekend Brussels 2026 journey
        </p>
      </div>

      <div class="space-y-12">
        <!-- Friday -->
        <div class="bg-white rounded-xl shadow-lg p-8">
          <div class="flex items-center mb-6">
            <div class="bg-blue-600 text-white w-12 h-12 rounded-full flex items-center justify-center font-bold text-lg mr-4">
              Fri
            </div>
            <div>
              <h3 class="text-2xl font-bold text-gray-900">Friday Evening: Ignition</h3>
              <p class="text-gray-600">6:00 PM - 10:00 PM</p>
            </div>
          </div>
          <div class="grid md:grid-cols-3 gap-6">
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">🎤 60-Second Pitches</h4>
              <p class="text-gray-600 text-sm">Present your AI startup idea to the community</p>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">🗳️ Voting & Selection</h4>
              <p class="text-gray-600 text-sm">Community votes for the most promising ideas</p>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">🤝 Team Formation</h4>
              <p class="text-gray-600 text-sm">Find your co-founders and form diverse teams</p>
            </div>
          </div>
        </div>

        <!-- Saturday -->
        <div class="bg-white rounded-xl shadow-lg p-8">
          <div class="flex items-center mb-6">
            <div class="bg-purple-600 text-white w-12 h-12 rounded-full flex items-center justify-center font-bold text-lg mr-4">
              Sat
            </div>
            <div>
              <h3 class="text-2xl font-bold text-gray-900">Saturday: Build & Validate</h3>
              <p class="text-gray-600">9:00 AM - 10:00 PM</p>
            </div>
          </div>
          <div class="grid md:grid-cols-4 gap-6">
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">💻 Development</h4>
              <p class="text-gray-600 text-sm">Build your MVP with AI tools and frameworks</p>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">🔬 Customer Discovery</h4>
              <p class="text-gray-600 text-sm">Validate your assumptions with real users</p>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">🎨 Design & UX</h4>
              <p class="text-gray-600 text-sm">Create compelling user experiences</p>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">📊 Business Model</h4>
              <p class="text-gray-600 text-sm">Develop sustainable business strategies</p>
            </div>
          </div>
        </div>

        <!-- Sunday -->
        <div class="bg-white rounded-xl shadow-lg p-8">
          <div class="flex items-center mb-6">
            <div class="bg-green-600 text-white w-12 h-12 rounded-full flex items-center justify-center font-bold text-lg mr-4">
              Sun
            </div>
            <div>
              <h3 class="text-2xl font-bold text-gray-900">Sunday: Present & Launch</h3>
              <p class="text-gray-600">9:00 AM - 8:00 PM</p>
            </div>
          </div>
          <div class="grid md:grid-cols-3 gap-6">
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">🎯 Final Push</h4>
              <p class="text-gray-600 text-sm">Polish your product and prepare presentations</p>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">🏆 Final Pitches</h4>
              <p class="text-gray-600 text-sm">5-minute presentations to expert judges</p>
            </div>
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">🎉 Awards Ceremony</h4>
              <p class="text-gray-600 text-sm">Celebrate achievements and network</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who Should Participate -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Who Should Participate?
        </h2>
        <p class="text-xl text-gray-600">
          Startup Weekend Brussels 2026 welcomes everyone passionate about AI and innovation
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-3">👩‍💻 Developers & Engineers</h3>
          <p class="text-gray-600 text-sm mb-4">
            AI/ML engineers, full-stack developers, data scientists, and technical experts ready to build.
          </p>
          <div class="text-xs text-blue-600 font-medium">Skills: Python, TensorFlow, React, APIs, Cloud</div>
        </div>

        <div class="bg-purple-50 border border-purple-200 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-3">🎨 Designers & UX Experts</h3>
          <p class="text-gray-600 text-sm mb-4">
            Product designers, UX/UI specialists, and creative minds who understand human-centered AI design.
          </p>
          <div class="text-xs text-purple-600 font-medium">Skills: Figma, User Research, Prototyping</div>
        </div>

        <div class="bg-green-50 border border-green-200 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-3">💼 Business Professionals</h3>
          <p class="text-gray-600 text-sm mb-4">
            Entrepreneurs, product managers, marketers, and business strategists with AI industry knowledge.
          </p>
          <div class="text-xs text-green-600 font-medium">Skills: Strategy, Marketing, Sales, Finance</div>
        </div>

        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-3">🧠 AI Researchers & Students</h3>
          <p class="text-gray-600 text-sm mb-4">
            Academic researchers, PhD students, and AI enthusiasts with deep technical knowledge.
          </p>
          <div class="text-xs text-yellow-600 font-medium">Skills: Research, Machine Learning, Analytics</div>
        </div>

        <div class="bg-red-50 border border-red-200 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-3">🏭 Industry Experts</h3>
          <p class="text-gray-600 text-sm mb-4">
            Domain specialists from healthcare, finance, logistics, and other industries being transformed by AI.
          </p>
          <div class="text-xs text-red-600 font-medium">Skills: Industry Knowledge, Problem Identification</div>
        </div>

        <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-3">🚀 Aspiring Entrepreneurs</h3>
          <p class="text-gray-600 text-sm mb-4">
            Anyone with passion for AI innovation and entrepreneurship, regardless of technical background.
          </p>
          <div class="text-xs text-indigo-600 font-medium">Skills: Curiosity, Enthusiasm, Vision</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Registration Section -->
  <section id="register" class="py-16 bg-gradient-to-r from-gray-100 to-blue-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Pre-Register for SW Brussels 2026
        </h2>
        <p class="text-xl text-gray-600 mb-6">
          Official dates and registration will be announced soon. Pre-register now to be among the first to know!
        </p>
        <div class="bg-blue-600 text-white rounded-lg p-4 inline-block">
          <p class="font-semibold">🎯 Limited Spots Available • Early Bird Discounts • Exclusive Updates</p>
        </div>
      </div>

      <RegistrationForm client:load />
    </div>
  </section>

  <!-- FAQ Teaser -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Frequently Asked Questions
        </h2>
      </div>

      <div class="space-y-6">
        <div class="bg-gray-50 rounded-lg p-6">
          <h3 class="font-semibold text-gray-900 mb-2">Do I need to have an AI background to participate?</h3>
          <p class="text-gray-600">
            Not at all! While we encourage AI-focused projects, we welcome participants from all backgrounds. The beauty of Startup Weekend is bringing together diverse skills and perspectives.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-6">
          <h3 class="font-semibold text-gray-900 mb-2">What if I don't have a team or idea?</h3>
          <p class="text-gray-600">
            Perfect! Many participants come solo and form amazing teams on Friday night. You can also join existing teams that need your skills.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-6">
          <h3 class="font-semibold text-gray-900 mb-2">Will there be AI tools and resources available?</h3>
          <p class="text-gray-600">
            Yes! We're partnering with AI companies to provide access to APIs, development tools, and platforms for all participants.
          </p>
        </div>

        <div class="bg-gray-50 rounded-lg p-6">
          <h3 class="font-semibold text-gray-900 mb-2">What's included in the registration fee?</h3>
          <p class="text-gray-600">
            All meals, snacks, drinks, workspace, mentorship, and access to tools throughout the weekend. Plus swag and potential prizes!
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Updates CTA -->
  <section class="py-16 bg-gradient-to-r from-blue-600 to-purple-600 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        Stay Updated
      </h2>
      <p class="text-xl mb-8 text-blue-100">
        Be the first to know when we announce the official dates, venue, and open registration for Startup Weekend Brussels 2026.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
        <a href="#register" class="bg-white text-blue-600 px-8 py-4 rounded-lg font-semibold hover:bg-blue-50 transition-colors">
          Pre-Register Now
        </a>
        <a href="/about" class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold hover:bg-white hover:text-blue-600 transition-colors">
          Learn More About SW
        </a>
      </div>
      
      <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6 max-w-md mx-auto">
        <h3 class="font-semibold text-lg mb-4">Follow for Real-Time Updates</h3>
        <div class="flex justify-center space-x-6">
          <a 
            href="https://x.com/swbru" 
            target="_blank" 
            rel="noopener"
            class="text-blue-100 hover:text-white transition-colors"
            aria-label="Follow us on X"
          >
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a 
            href="https://www.facebook.com/swbru" 
            target="_blank" 
            rel="noopener"
            class="text-blue-100 hover:text-white transition-colors"
            aria-label="Follow us on Facebook"
          >
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a 
            href="https://www.instagram.com/swbru/" 
            target="_blank" 
            rel="noopener"
            class="text-blue-100 hover:text-white transition-colors"
            aria-label="Follow us on Instagram"
          >
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
        <p class="text-blue-200 text-sm mt-4">@swbru</p>
      </div>
    </div>
  </section>
</Layout>