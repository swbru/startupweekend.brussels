---
import Layout from '../layouts/Layout.astro';
import PreviousEditionsForm from '../components/PreviousEditionsForm.jsx';
---

<Layout 
  title="Previous Startup Weekend Brussels Editions - History & Success Stories"
  description="Explore the history of Startup Weekend Brussels events. Share your memories and help us build a comprehensive archive of Brussels entrepreneurship."
  canonical="https://startupweekend.brussels/previous-editions"
  breadcrumbs={[{name: "Previous Editions", url: "/previous-editions"}]}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-blue-600 to-purple-600 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">
          Previous Editions
        </h1>
        <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto">
          Celebrating the entrepreneurs, startups, and innovations from past Startup Weekend Brussels events
        </p>
      </div>
    </div>
  </section>

  <!-- Under Construction Notice -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-yellow-50 to-orange-50 border border-yellow-200 rounded-xl p-8 text-center">
        <div class="text-6xl mb-6">🚧</div>
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          We're Building This Section
        </h2>
        <p class="text-lg text-gray-700 mb-6">
          We're currently collecting information about previous Startup Weekend events in Brussels. 
          This includes gathering photos, success stories, startup details, and participant testimonials.
        </p>
        <div class="bg-white rounded-lg p-6 shadow-md">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Help Us Complete the Story!</h3>
          <p class="text-gray-600 mb-4">
            Were you part of a previous Startup Weekend in Brussels? We'd love to hear from you and showcase your experience.
          </p>
          <div class="text-sm text-gray-500">
            <p>📧 Email us your stories, photos, and startup updates</p>
            <p>🤝 Connect with fellow alumni and organizers</p>
            <p>🏆 Help us celebrate past successes</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We're Looking For -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          What We're Collecting
        </h2>
        <p class="text-xl text-gray-600">
          Help us document the rich history of entrepreneurship in Brussels
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white rounded-lg p-6 shadow-md">
          <div class="text-3xl mb-4">📅</div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Event Details</h3>
          <ul class="text-gray-600 text-sm space-y-2">
            <li>• Dates and venues of past events</li>
            <li>• Number of participants and teams</li>
            <li>• Event themes and focuses</li>
            <li>• Organizing team information</li>
          </ul>
        </div>

        <div class="bg-white rounded-lg p-6 shadow-md">
          <div class="text-3xl mb-4">🚀</div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Startup Stories</h3>
          <ul class="text-gray-600 text-sm space-y-2">
            <li>• Winning teams and projects</li>
            <li>• Current status of startups</li>
            <li>• Funding and growth updates</li>
            <li>• Pivot stories and learnings</li>
          </ul>
        </div>

        <div class="bg-white rounded-lg p-6 shadow-md">
          <div class="text-3xl mb-4">📸</div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Media & Memories</h3>
          <ul class="text-gray-600 text-sm space-y-2">
            <li>• Event photos and videos</li>
            <li>• Pitch presentations</li>
            <li>• Team formation moments</li>
            <li>• Celebration highlights</li>
          </ul>
        </div>

        <div class="bg-white rounded-lg p-6 shadow-md">
          <div class="text-3xl mb-4">🏆</div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Success Metrics</h3>
          <ul class="text-gray-600 text-sm space-y-2">
            <li>• Awards and recognition</li>
            <li>• Media coverage</li>
            <li>• Participant feedback</li>
            <li>• Community impact</li>
          </ul>
        </div>

        <div class="bg-white rounded-lg p-6 shadow-md">
          <div class="text-3xl mb-4">🤝</div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Community Network</h3>
          <ul class="text-gray-600 text-sm space-y-2">
            <li>• Participant testimonials</li>
            <li>• Mentor and judge profiles</li>
            <li>• Sponsor partnerships</li>
            <li>• Volunteer contributions</li>
          </ul>
        </div>

        <div class="bg-white rounded-lg p-6 shadow-md">
          <div class="text-3xl mb-4">💡</div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">Innovation Highlights</h3>
          <ul class="text-gray-600 text-sm space-y-2">
            <li>• Technology trends</li>
            <li>• Creative solutions</li>
            <li>• Industry disruptions</li>
            <li>• Social impact projects</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Contribution Form Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          🔍 Share Your SW Brussels Story
        </h2>
        <p class="text-xl text-gray-600 mb-6">
          Help us build a comprehensive archive by sharing your memories, photos, and experiences from previous Startup Weekend Brussels events.
        </p>
      </div>

      <PreviousEditionsForm client:load />
    </div>
  </section>

  <!-- Call for Contributions -->
  <section class="py-16 bg-gradient-to-r from-gray-100 to-blue-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-blue-600 to-purple-600 rounded-2xl p-8 text-white text-center">
        <h2 class="text-3xl font-bold mb-4">
          📞 Additional Ways to Contribute
        </h2>
        <p class="text-xl text-blue-100 mb-6">
          Have extensive materials or prefer to discuss directly? We'd love to connect with you personally.
        </p>
        
        <div class="grid md:grid-cols-3 gap-6 mb-8">
          <div>
            <h3 class="font-semibold text-lg mb-2">📧 Direct Contact</h3>
            <p class="text-blue-100 text-sm">Email us directly with large photo collections or detailed stories</p>
          </div>
          <div>
            <h3 class="font-semibold text-lg mb-2">🤝 Alumni Network</h3>
            <p class="text-blue-100 text-sm">Join our growing network of SW Brussels alumni</p>
          </div>
          <div>
            <h3 class="font-semibold text-lg mb-2">📹 Video Interviews</h3>
            <p class="text-blue-100 text-sm">Share your story through a recorded interview</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/2026-edition#register" class="bg-white text-blue-600 px-6 py-3 rounded-lg font-semibold hover:bg-blue-50 transition-colors">
            Join SW Brussels 2026
          </a>
          <a href="#" class="border-2 border-white text-white px-6 py-3 rounded-lg font-semibold hover:bg-white hover:text-blue-600 transition-colors">
            Email Alumni Team
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Placeholder for Future Content -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Coming Soon: Complete Event Archive
        </h2>
        <p class="text-xl text-gray-600">
          This section will feature detailed information about each Startup Weekend Brussels event
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Placeholder for timeline -->
        <div class="bg-white rounded-lg p-8 shadow-md">
          <h3 class="text-2xl font-semibold text-gray-900 mb-4">📈 Event Timeline</h3>
          <div class="space-y-4">
            <div class="border-l-4 border-gray-300 pl-4">
              <div class="text-gray-500 text-sm">Coming Soon</div>
              <div class="font-semibold text-gray-400">SW Brussels 2019-2024</div>
              <div class="text-gray-400 text-sm">Event details, participants, and outcomes</div>
            </div>
            <div class="border-l-4 border-gray-300 pl-4">
              <div class="text-gray-500 text-sm">Coming Soon</div>
              <div class="font-semibold text-gray-400">Early Brussels Events</div>
              <div class="text-gray-400 text-sm">Historical context and founding stories</div>
            </div>
          </div>
        </div>

        <!-- Placeholder for success stories -->
        <div class="bg-white rounded-lg p-8 shadow-md">
          <h3 class="text-2xl font-semibold text-gray-900 mb-4">🏆 Success Stories</h3>
          <div class="space-y-4">
            <div class="bg-gray-50 rounded-lg p-4">
              <div class="font-semibold text-gray-400 mb-2">Startup Success Story #1</div>
              <div class="text-gray-400 text-sm">Details about winning teams and their current status</div>
            </div>
            <div class="bg-gray-50 rounded-lg p-4">
              <div class="font-semibold text-gray-400 mb-2">Startup Success Story #2</div>
              <div class="text-gray-400 text-sm">Funding milestones and growth achievements</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Global SW Network -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-4">
        Part of a Global Movement
      </h2>
      <p class="text-xl text-gray-600 mb-8">
        While we build our Brussels archive, explore the global Startup Weekend community and its incredible impact worldwide.
      </p>
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <div class="text-3xl font-bold text-blue-600 mb-2">3000+</div>
          <p class="text-gray-600">Cities Worldwide</p>
        </div>
        <div>
          <div class="text-3xl font-bold text-purple-600 mb-2">1M+</div>
          <p class="text-gray-600">Global Participants</p>
        </div>
        <div>
          <div class="text-3xl font-bold text-green-600 mb-2">25K+</div>
          <p class="text-gray-600">Startups Created</p>
        </div>
      </div>
    </div>
  </section>
</Layout>