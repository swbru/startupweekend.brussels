---
export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  breadcrumbs?: Array<{name: string, url: string}>;
}

const { 
  title, 
  description = "Startup Weekend Brussels - Where ideas become reality in 54 hours", 
  canonical,
  ogImage = "/Startup-Weekend-Brussels.png",
  ogType = "website",
  breadcrumbs = []
} = Astro.props;

const currentUrl = new URL(Astro.request.url);
const canonicalUrl = canonical || currentUrl.href;
const siteName = "Startup Weekend Brussels";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="startup weekend, brussels, entrepreneurship, hackathon, AI, innovation, business, startups, networking, belgium" />
    <meta name="author" content="Startup Weekend Brussels" />
    <meta name="robots" content="index, follow" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Favicon and Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/Startup-Weekend-Brussels.png" />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, currentUrl).href} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@swbru" />
    <meta name="twitter:creator" content="@swbru" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, currentUrl).href} />
    
    <!-- Page Title -->
    <title>{title}</title>
    
    <!-- Structured Data - Organization -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Startup Weekend Brussels",
      "url": "https://startupweekend.brussels",
      "logo": "https://startupweekend.brussels/Startup-Weekend-Brussels.png",
      "description": "Startup Weekend Brussels organizes 54-hour entrepreneurship events where ideas become reality through collaboration between entrepreneurs, developers, and designers.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Brussels",
        "addressRegion": "Brussels-Capital Region",
        "addressCountry": "BE"
      },
      "sameAs": [
        "https://x.com/swbru",
        "https://www.facebook.com/swbru",
        "https://www.instagram.com/swbru/"
      ],
      "foundingLocation": "Brussels, Belgium",
      "areaServed": "Brussels, Belgium"
    }
    </script>
    
    <!-- Structured Data - Website -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Startup Weekend Brussels",
      "url": "https://startupweekend.brussels",
      "description": "Official website for Startup Weekend Brussels - 54-hour entrepreneurship events in Brussels",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://startupweekend.brussels/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Startup Weekend Brussels"
      }
    }
    </script>
    
    <!-- Additional Meta Tags for specific pages will be added by each page -->
  </head>
  <body class="bg-gray-50 min-h-screen">
    <!-- Navigation -->
    <nav class="bg-white/90 backdrop-blur-md border-b border-white/20 shadow-lg sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <a href="/" class="flex items-center space-x-3">
              <img src="/Startup-Weekend-Brussels.png" alt="Startup Weekend Brussels" class="h-10 w-auto" />
              <span class="font-bold text-xl text-gray-900">Startup Weekend Brussels</span>
            </a>
          </div>
          
          <!-- Desktop Navigation -->
          <div class="hidden md:flex items-center space-x-8">
            <a href="/" class="text-gray-700 hover:text-blue-600 transition-colors">Home</a>
            <a href="/about" class="text-gray-700 hover:text-blue-600 transition-colors">About SW</a>
            <a href="/2026-edition" class="text-gray-700 hover:text-blue-600 transition-colors">2026 Edition</a>
            <a href="/previous-editions" class="text-gray-700 hover:text-blue-600 transition-colors">Previous Editions</a>
            <a href="/2026-edition#register" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
              Pre-Register
            </a>
          </div>

          <!-- Mobile menu button -->
          <div class="md:hidden flex items-center">
            <button id="mobile-menu-button" class="text-gray-700 hover:text-blue-600">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Navigation -->
        <div id="mobile-menu" class="md:hidden hidden pb-4">
          <div class="flex flex-col space-y-2">
            <a href="/" class="text-gray-700 hover:text-blue-600 transition-colors py-2">Home</a>
            <a href="/about" class="text-gray-700 hover:text-blue-600 transition-colors py-2">About SW</a>
            <a href="/2026-edition" class="text-gray-700 hover:text-blue-600 transition-colors py-2">2026 Edition</a>
            <a href="/previous-editions" class="text-gray-700 hover:text-blue-600 transition-colors py-2">Previous Editions</a>
            <a href="/2026-edition#register" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors text-center mt-2">
              Pre-Register
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Breadcrumb Navigation -->
    {breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="bg-gray-50 border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
          <ol class="flex items-center space-x-2 text-sm">
            <li>
              <a href="/" class="text-gray-500 hover:text-blue-600 transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
                </svg>
                <span class="sr-only">Home</span>
              </a>
            </li>
            {breadcrumbs.map((crumb, index) => (
              <li class="flex items-center">
                <svg class="w-4 h-4 text-gray-400 mx-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
                {index === breadcrumbs.length - 1 ? (
                  <span class="text-gray-900 font-medium">{crumb.name}</span>
                ) : (
                  <a href={crumb.url} class="text-gray-500 hover:text-blue-600 transition-colors">
                    {crumb.name}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </div>
        
        <!-- Breadcrumb Structured Data -->
        {breadcrumbs.length > 0 && (
          <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://startupweekend.brussels/"
              },
              ...breadcrumbs.map((crumb, index) => ({
                "@type": "ListItem",
                "position": index + 2,
                "name": crumb.name,
                "item": `https://startupweekend.brussels${crumb.url}`
              }))
            ]
          }
          </script>
        )}
      </nav>
    )}

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid md:grid-cols-3 gap-8">
          <div>
            <div class="flex items-center space-x-3 mb-4">
              <img src="/Startup-Weekend-Brussels.png" alt="Startup Weekend Brussels" class="h-8 w-auto" />
              <span class="font-bold text-lg">Startup Weekend Brussels</span>
            </div>
            <p class="text-gray-400">
              Where ideas become reality in 54 hours. Join the most exciting entrepreneurial event in Brussels.
            </p>
          </div>
          
          <div>
            <h3 class="font-semibold text-lg mb-4">Quick Links</h3>
            <div class="space-y-2">
              <a href="/about" class="text-gray-400 hover:text-white transition-colors block">About Startup Weekend</a>
              <a href="/2026-edition" class="text-gray-400 hover:text-white transition-colors block">2026 Edition</a>
              <a href="/previous-editions" class="text-gray-400 hover:text-white transition-colors block">Previous Editions</a>
            </div>
          </div>
          
          <div>
            <h3 class="font-semibold text-lg mb-4">Connect With Us</h3>
            <div class="space-y-3">
              <p class="text-gray-400">Follow us for updates and announcements</p>
              <div class="flex space-x-4">
                <a 
                  href="https://x.com/swbru" 
                  target="_blank" 
                  rel="noopener"
                  class="text-gray-400 hover:text-white transition-colors"
                  aria-label="Follow us on X (Twitter)"
                >
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </a>
                <a 
                  href="https://www.facebook.com/swbru" 
                  target="_blank" 
                  rel="noopener"
                  class="text-gray-400 hover:text-white transition-colors"
                  aria-label="Follow us on Facebook"
                >
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </a>
                <a 
                  href="https://www.instagram.com/swbru/" 
                  target="_blank" 
                  rel="noopener"
                  class="text-gray-400 hover:text-white transition-colors"
                  aria-label="Follow us on Instagram"
                >
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                </a>
              </div>
              <div class="text-gray-500 text-sm">
                <p>@swbru on all platforms</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="border-t border-gray-800 mt-8 pt-8">
          <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
            <p class="text-gray-400 text-center md:text-left">
              &copy; 2025 Startup Weekend Brussels. All rights reserved.
            </p>
            
            <div class="flex items-center space-x-2 text-gray-400">
              <span class="text-sm">Powered by</span>
              <a 
                href="https://www.getonyx.eu" 
                target="_blank" 
                rel="noopener"
                class="flex items-center space-x-2 hover:text-white transition-colors group"
              >
                <img 
                  src="/onyx-logo.svg" 
                  alt="Onyx" 
                  class="h-5 w-auto opacity-75 group-hover:opacity-100 transition-opacity"
                />
                <span class="text-sm font-medium">Onyx</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Mobile menu toggle
      document.getElementById('mobile-menu-button')?.addEventListener('click', () => {
        const mobileMenu = document.getElementById('mobile-menu');
        mobileMenu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>